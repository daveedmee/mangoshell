@import "colors.rasi"

/* Flat launcher matching the Quickshell surfaces: one-pixel borders,
 * low radii, and no pill-shaped controls. */

* {
    font: "Futura PT Demi 11";
    background-color: transparent;
    text-color: @col-fg;
    border-color: @col-border;
}

window {
    width: 660px;
    location: center;
    anchor: center;
    x-offset: 0px;
    y-offset: 0px;
    background-color: @col-bg;
    border: 1px;
    border-color: @col-border;
    border-radius: 5px;
    padding: 10px;
}

mainbox {
    spacing: 8px;
}

inputbar {
    background-color: @col-input;
    border: 1px;
    border-color: @col-border;
    border-radius: 3px;
    padding: 8px 10px;
    spacing: 8px;
}

prompt {
    text-color: @col-dim;
}

entry {
    text-color: @col-fg;
}

listview {
    lines: 9;
    columns: 1;
    spacing: 2px;
    background-color: transparent;
    scrollbar: true;
    border: 0px;
}

element {
    background-color: transparent;
    border: 1px;
    border-color: transparent;
    border-radius: 3px;
    padding: 7px 8px;
    spacing: 8px;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: @col-fg;
}

element selected {
    background-color: @col-selected;
    border-color: @col-border;
}

element-text selected {
    text-color: @col-fg;
}

scrollbar {
    width: 3px;
    handle-width: 3px;
    handle-color: @col-dim;
    border-radius: 1px;
    background-color: transparent;
}

mode-switcher {
    spacing: 4px;
}

button {
    background-color: transparent;
    text-color: @col-dim;
    border: 1px;
    border-color: transparent;
    border-radius: 3px;
    padding: 5px 9px;
}

button selected {
    background-color: @col-selected;
    border-color: @col-border;
    text-color: @col-fg;
}

textbox {
    text-color: @col-fg;
}
